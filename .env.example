# ============================================================
# AI Gateway — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ── Required ────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxx
DATABASE_URL=postgresql://gateway:password@localhost:5432/gateway
REDIS_URL=redis://localhost:6379

# API key the CRM uses to authenticate with this gateway.
# Generate with: openssl rand -hex 32
GATEWAY_API_KEY=your-secret-key-for-crm-to-gateway-auth

# Admin key for /v1/admin/* endpoints (quota updates, etc.)
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=your-admin-secret-key

# ── Server ──────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info                  # trace | debug | info | warn | error

# ── DeepSeek ────────────────────────────────────────────────
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_RETRIES=3

# ── Quotas / billing defaults (per-tenant overrides in DB) ──
DEFAULT_MONTHLY_QUERY_LIMIT=5000
DEFAULT_MONTHLY_TOKEN_LIMIT=1000000
DEFAULT_MARKUP_MULTIPLIER=10.0

# ── Caching ─────────────────────────────────────────────────
ENABLE_CACHE=true
CACHE_TTL_SECONDS=86400         # 24 hours

# ── Rate limiting ────────────────────────────────────────────
# Requests per minute per tenant
RATE_LIMIT_RPM=60
# Burst allowance on top of RPM
RATE_LIMIT_BURST=10

# ── Metrics ─────────────────────────────────────────────────
ENABLE_METRICS=true

# ── Observability ───────────────────────────────────────────
# Optional: Datadog/Loki agent endpoint for log shipping
# LOG_SHIP_URL=http://localhost:9080/loki/api/v1/push
